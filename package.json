{
	"name": "@prestomedia/fanstack",
	"version": "1.0.2",
	"description": "Connect Firebase Functions to Angular with end-to-end type safety and context-building middleware.",
	"license": "MIT",
	"author": "Prestomedia, LLC",
	"homepage": "https://fanstack.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PrestomediaLLC/fanstack.git"
	},
	"bugs": {
		"url": "https://github.com/PrestomediaLLC/fanstack/issues"
	},
	"type": "module",
	"bin": {
		"fan": "./bin/fan-stack.js"
	},
	"files": [
		"dist",
		"templates",
		"bin"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\" && tsc && node scripts/chmod.js"
	},
	"dependencies": {
		"chokidar": "^4.0.1",
		"inquirer": "^9.2.12"
	},
	"devDependencies": {
		"@types/inquirer": "^9.0.10",
		"@types/node": "^25.9.3",
		"typescript": "^5.0.0"
	},
	"keywords": [
		"angular",
		"firebase",
		"firebase-functions",
		"typescript",
		"angularfire",
		"angular service",
		"type-safety",
		"code-generation",
		"code-generator",
		"cli",
		"rpc",
		"middleware",
		"serverless",
		"https-callable"
	]
}
